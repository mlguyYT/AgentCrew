#!/usr/bin/env bash
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)" || exit 1
DEFAULT_ROOT="$(cd "$SELF_DIR/.." && pwd -P)" || exit 1

START_MARKER="<!-- AgentCrew global loader: start -->"
END_MARKER="<!-- AgentCrew global loader: end -->"

usage() {
  printf '%s\n' "Usage: agentcrew COMMAND [options]"
  printf '%s\n' ""
  printf '%s\n' "Commands:"
  printf '%s\n' "  install             Register AgentCrew with supported coding agents"
  printf '%s\n' "  uninstall           Remove AgentCrew global loader blocks"
  printf '%s\n' "  status              Show registrations and project dashboard"
  printf '%s\n' "  doctor              Check AgentCrew setup health"
  printf '%s\n' "  detect-project      Detect project stack, tools, and suggested Skills"
  printf '%s\n' "  preset              Select a project preset and write .agent-state/project-preset.md"
  printf '%s\n' "  classify            Classify a request into lane, role, Skills, and gates"
  printf '%s\n' "  context             Print a phase-based context load manifest"
  printf '%s\n' "  start               Start a task and write .agent-state/current-task.md"
  printf '%s\n' "  brief               Create a task brief with acceptance criteria"
  printf '%s\n' "  plan                Create a PR-sized work plan"
  printf '%s\n' "  ready               Check whether implementation is ready to start"
  printf '%s\n' "  pr-pack             Prepare a compact PR packet for human review"
  printf '%s\n' "  save-session        Save a project-local session checkpoint"
  printf '%s\n' "  restore-session     Restore the latest project-local session checkpoint"
  printf '%s\n' "  checkpoint          Save a compact [agentcrew-context] checkpoint block"
  printf '%s\n' ""
  printf '%s\n' "Options:"
  printf '%s\n' "  --agent NAME        all, claude, codex, openclaw, or hermes. Default: all"
  printf '%s\n' "  --root PATH         AgentCrew checkout path. Default: this checkout"
  printf '%s\n' "  --project PATH      Target project path. Default: current directory"
  printf '%s\n' "  --task TEXT         Request text for classify, context, start, brief, or plan"
  printf '%s\n' "  --title TEXT        Session title for save-session or checkpoint"
  printf '%s\n' "  --summary TEXT      Session summary"
  printf '%s\n' "  --decision TEXT     Decision to save. May be repeated"
  printf '%s\n' "  --next TEXT         Next step to save. May be repeated"
  printf '%s\n' "  --note TEXT         Note to save. May be repeated"
  printf '%s\n' "  --tried TEXT        Failed approach to save. May be repeated"
  printf '%s\n' "  --risk TEXT         Risk to save. May be repeated"
  printf '%s\n' "  --skill TEXT        Skill or role to save. May be repeated"
  printf '%s\n' "  --validation TEXT   Validation evidence to save. May be repeated"
  printf '%s\n' "  --file PATH         Session file for restore-session"
  printf '%s\n' "  --out-dir PATH      Session output directory"
  printf '%s\n' "  --force             Overwrite generated state when using preset/start/brief/plan/ready/pr-pack"
  printf '%s\n' "  --dry-run           Print planned changes without writing files"
  printf '%s\n' "  -h, --help          Show help"
}

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

absolute_path() {
  local path="$1"
  [ -d "$path" ] || die "AgentCrew root does not exist: $path"
  (cd "$path" && pwd -P) || exit 1
}

require_agentcrew_root() {
  local root="$1"
  [ -f "$root/AGENTS.md" ] || die "Missing AGENTS.md in AgentCrew root: $root"
  [ -d "$root/agent-team" ] || die "Missing agent-team/ in AgentCrew root: $root"
}

upsert_block() {
  local file="$1"
  local content="$2"
  local dry_run="$3"

  if [ "$dry_run" = "true" ]; then
    printf '%s\n' "Would update: $file"
    printf '%s\n' "$START_MARKER"
    printf '%s\n' "$content"
    printf '%s\n' "$END_MARKER"
    return 0
  fi

  # Refuse to rewrite the file unless the existing marker block clearly looks
  # like a managed AgentCrew loader. Without this check, a user who pastes our
  # marker strings around their own content (from a tutorial, dotfiles, etc.)
  # silently loses that content on the next install (security review HIGH-1).
  if [ -f "$file" ]; then
    local start_count end_count
    start_count="$(grep -Fxc "$START_MARKER" "$file" || true)"
    end_count="$(grep -Fxc "$END_MARKER" "$file" || true)"
    if [ "$start_count" -ne "$end_count" ]; then
      die "Refusing to update $file: found $start_count start marker(s) and $end_count end marker(s). Resolve the mismatch by hand, then rerun install." 1
    fi
    if [ "$start_count" -gt 1 ]; then
      die "Refusing to update $file: found $start_count AgentCrew loader blocks. Keep at most one managed block; remove the extras manually, then rerun install." 1
    fi
    if [ "$start_count" -eq 1 ]; then
      # All AgentCrew-managed loaders begin with the heading "# AgentCrew".
      # If the existing block's first non-blank line differs, the markers are
      # almost certainly user content; refuse rather than overwrite.
      local first_line
      first_line="$(awk -v start="$START_MARKER" -v end="$END_MARKER" '
        $0 == start { in_block = 1; next }
        $0 == end { in_block = 0; next }
        in_block && NF > 0 { print; exit }
      ' "$file")"
      if [ "$first_line" != "# AgentCrew" ]; then
        die "Refusing to update $file: marker block does not look like a managed AgentCrew loader (first non-blank line is \"$first_line\", expected \"# AgentCrew\"). Verify the file, then rerun install or remove the markers manually." 1
      fi
    fi
  fi

  local parent_existed="true"
  [ -d "$(dirname "$file")" ] || parent_existed="false"
  mkdir -p "$(dirname "$file")" || exit 1

  local tmp
  tmp="$(mktemp)" || exit 1

  if [ -f "$file" ]; then
    awk -v start="$START_MARKER" -v end="$END_MARKER" '
      $0 == start { skip = 1; next }
      $0 == end { skip = 0; next }
      skip != 1 { print }
    ' "$file" > "$tmp" || exit 1

    if [ -s "$tmp" ] && [ "$(tail -c 1 "$tmp" | wc -l)" -eq 0 ]; then
      printf '\n' >> "$tmp"
    fi
    if [ -s "$tmp" ]; then
      printf '\n' >> "$tmp"
    fi
  fi

  {
    cat "$tmp"
    printf '%s\n' "$START_MARKER"
    printf '%s\n' "$content"
    printf '%s\n' "$END_MARKER"
  } > "$file" || exit 1

  # Loader files configure agent behavior; treat them like SSH keys and lock
  # them to the user. If AgentCrew also created the parent directory (e.g.,
  # `~/.codex/` on a fresh install) tighten that too. Leave pre-existing
  # parent directories alone — they may be shared with other tooling.
  chmod 600 "$file" 2>/dev/null || true
  if [ "$parent_existed" = "false" ]; then
    chmod 700 "$(dirname "$file")" 2>/dev/null || true
  fi

  rm -f "$tmp"
  printf '%s\n' "Updated: $file"
}

remove_block() {
  local file="$1"
  local dry_run="$2"

  if [ ! -f "$file" ]; then
    printf '%s\n' "No file found: $file"
    return 0
  fi

  if ! grep -Fq "$START_MARKER" "$file"; then
    printf '%s\n' "No AgentCrew loader found: $file"
    return 0
  fi

  local start_count
  local end_count
  start_count="$(grep -Fxc "$START_MARKER" "$file" || true)"
  end_count="$(grep -Fxc "$END_MARKER" "$file" || true)"

  if [ "$start_count" -ne "$end_count" ]; then
    die "Found mismatched AgentCrew loader markers in: $file" 1
  fi

  if [ "$dry_run" = "true" ]; then
    printf '%s\n' "Would remove AgentCrew loader from: $file"
    return 0
  fi

  local tmp
  tmp="$(mktemp)" || exit 1
  awk -v start="$START_MARKER" -v end="$END_MARKER" '
    $0 == start { skip = 1; next }
    $0 == end { skip = 0; next }
    skip != 1 { print }
  ' "$file" > "$tmp" || exit 1
  mv "$tmp" "$file" || exit 1
  printf '%s\n' "Removed AgentCrew loader from: $file"
}

claude_file() {
  printf '%s\n' "$HOME/.claude/CLAUDE.md"
}

codex_file() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
}

is_safe_profile_name() {
  # Only allow alphanumerics, underscore, and dash. Anything else (slashes,
  # dots, traversal sequences, shell metachars) is rejected so a malicious
  # env-var value cannot escape the per-tool home directory.
  case "$1" in
    ""|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

openclaw_state_dir() {
  if [ -n "${OPENCLAW_STATE_DIR:-}" ]; then
    printf '%s\n' "$OPENCLAW_STATE_DIR"
  elif [ -n "${OPENCLAW_PROFILE:-}" ]; then
    if is_safe_profile_name "$OPENCLAW_PROFILE"; then
      printf '%s\n' "$HOME/.openclaw-$OPENCLAW_PROFILE"
    else
      printf 'Ignoring OPENCLAW_PROFILE=%s: only [A-Za-z0-9_-] allowed; using default.\n' "$OPENCLAW_PROFILE" >&2
      printf '%s\n' "$HOME/.openclaw"
    fi
  else
    printf '%s\n' "$HOME/.openclaw"
  fi
}

openclaw_file() {
  printf '%s\n' "$(openclaw_state_dir)/workspace/AGENTS.md"
}

openclaw_detected() {
  [ -d "$(openclaw_state_dir)" ] || command -v openclaw >/dev/null 2>&1
}

hermes_home() {
  if [ -n "${HERMES_HOME:-}" ]; then
    printf '%s\n' "$HERMES_HOME"
  elif [ -n "${HERMES_PROFILE:-}" ] && [ "${HERMES_PROFILE:-}" != "default" ]; then
    if is_safe_profile_name "$HERMES_PROFILE"; then
      printf '%s\n' "$HOME/.hermes/profiles/$HERMES_PROFILE"
    else
      printf 'Ignoring HERMES_PROFILE=%s: only [A-Za-z0-9_-] allowed; using default.\n' "$HERMES_PROFILE" >&2
      printf '%s\n' "$HOME/.hermes"
    fi
  elif [ -f "$HOME/.hermes/active_profile" ]; then
    local active_profile
    active_profile="$(head -n 1 "$HOME/.hermes/active_profile" | tr -d '[:space:]')"
    case "$active_profile" in
      ""|default)
        printf '%s\n' "$HOME/.hermes"
        ;;
      *[!a-zA-Z0-9_-]*)
        printf '%s\n' "$HOME/.hermes"
        ;;
      *)
        if [ -d "$HOME/.hermes/profiles/$active_profile" ]; then
          printf '%s\n' "$HOME/.hermes/profiles/$active_profile"
        else
          printf '%s\n' "$HOME/.hermes"
        fi
        ;;
    esac
  else
    printf '%s\n' "$HOME/.hermes"
  fi
}

hermes_file() {
  printf '%s\n' "$(hermes_home)/SOUL.md"
}

hermes_detected() {
  [ -d "$(hermes_home)" ] || command -v hermes >/dev/null 2>&1
}

claude_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

@$root/AGENTS.md

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

## AgentCrew Activation Policy

For any project, product, coding, debugging, design, review, planning, testing, documentation, research, or architecture request, apply AgentCrew automatically.

The user should not need to say "use AgentCrew" or name a role, lane, Skill, playbook, or command.

Before using another workflow, skill pack, planning system, or agent methodology, first route the request through AgentCrew:

1. Read \`$root/AGENTS.md\`.
2. Use Direct Answer Mode for simple questions.
3. Use staged loading for action.
4. Classify the request and choose the lane, role, Skills, gates, and next human approval point.
5. Use other tools or skills only as execution aids after AgentCrew routing, or when the user explicitly asks for that other system.

Do not replace AgentCrew with another workflow by default.

Keep human approval final and do not merge pull requests.
EOF
}

