}

openclaw_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

## AgentCrew Activation Policy

For any project, product, coding, debugging, design, review, planning, testing, documentation, research, or architecture request, apply AgentCrew automatically.

The user should not need to say "use AgentCrew" or name a role, lane, Skill, playbook, or command.

Before using another workflow, skill pack, planning system, or agent methodology, first route the request through AgentCrew:

1. Read \`$root/AGENTS.md\`.
2. Use Direct Answer Mode for simple questions.
3. Use staged loading for action.
4. Classify the request and choose the lane, role, Skills, gates, and next human approval point.
5. Use other tools or skills only as execution aids after AgentCrew routing, or when the user explicitly asks for that other system.

Do not replace AgentCrew with another workflow by default.

Keep human approval final and do not merge pull requests.

AgentCrew is a coding-team workflow. It does not override OpenClaw identity, memory, channel, heartbeat, or safety instructions. If AgentCrew and OpenClaw instructions conflict, preserve safety, privacy, and human approval.
EOF
}

hermes_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

## AgentCrew Activation Policy

For any project, product, coding, debugging, design, review, planning, testing, documentation, research, or architecture request, apply AgentCrew automatically.

The user should not need to say "use AgentCrew" or name a role, lane, Skill, playbook, or command.

Before using another workflow, skill pack, planning system, or agent methodology, first route the request through AgentCrew:

1. Read \`$root/AGENTS.md\`.
2. Use Direct Answer Mode for simple questions.
3. Use staged loading for action.
4. Classify the request and choose the lane, role, Skills, gates, and next human approval point.
5. Use other tools or skills only as execution aids after AgentCrew routing, or when the user explicitly asks for that other system.

Do not replace AgentCrew with another workflow by default.

Keep human approval final and do not merge pull requests.

AgentCrew is a coding-team workflow. It does not replace Hermes Agent's identity, memory, skills, session history, gateway, profile, tool policy, or credential handling. If AgentCrew and Hermes instructions conflict, preserve safety, privacy, and human approval.
EOF
}

install_agent() {
  local agent="$1"
  local root="$2"
  local dry_run="$3"

  case "$agent" in
    claude)
      upsert_block "$(claude_file)" "$(claude_loader "$root")" "$dry_run"
      ;;
    codex)
      upsert_block "$(codex_file)" "$(codex_loader "$root")" "$dry_run"
      ;;
    openclaw)
      upsert_block "$(openclaw_file)" "$(openclaw_loader "$root")" "$dry_run"
      ;;
    hermes)
      upsert_block "$(hermes_file)" "$(hermes_loader "$root")" "$dry_run"
      ;;
    all)
      install_agent claude "$root" "$dry_run"
      install_agent codex "$root" "$dry_run"
      if openclaw_detected; then
        install_agent openclaw "$root" "$dry_run"
      else
        printf '%s\n' "Skipped OpenClaw: not detected. Use --agent openclaw to create the loader explicitly."
      fi
      if hermes_detected; then
        install_agent hermes "$root" "$dry_run"
      else
        printf '%s\n' "Skipped Hermes: not detected. Use --agent hermes to create the loader explicitly."
      fi
      ;;
    *)
      die "Unsupported agent: $agent" 2
      ;;
  esac
}

uninstall_agent() {
  local agent="$1"
  local dry_run="$2"

  case "$agent" in
    claude)
      remove_block "$(claude_file)" "$dry_run"
      ;;
    codex)
      remove_block "$(codex_file)" "$dry_run"
      ;;
    openclaw)
      remove_block "$(openclaw_file)" "$dry_run"
      ;;
    hermes)
      remove_block "$(hermes_file)" "$dry_run"
      ;;
    all)
      uninstall_agent claude "$dry_run"
      uninstall_agent codex "$dry_run"
      if openclaw_detected || [ -f "$(openclaw_file)" ]; then
        uninstall_agent openclaw "$dry_run"
      else
        printf '%s\n' "Skipped OpenClaw: not detected and no loader file found."
      fi
      if hermes_detected || [ -f "$(hermes_file)" ]; then
        uninstall_agent hermes "$dry_run"
      else
        printf '%s\n' "Skipped Hermes: not detected and no loader file found."
      fi
      ;;
    *)
      die "Unsupported agent: $agent" 2
      ;;
  esac
}

has_registration() {
  local file="$1"
  [ -f "$file" ] && grep -Fq "$START_MARKER" "$file"
}

status_agent() {
  local name="$1"
  local file="$2"
  if has_registration "$file"; then
    printf '%s\n' "$name: installed ($file)"
  else
    printf '%s\n' "$name: not installed ($file)"
  fi
}


DOCTOR_FAILS=0
DOCTOR_WARNINGS=0

check_pass() {
  printf 'PASS %s\n' "$1"
}

check_warn() {
  DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1))
  printf 'WARN %s\n' "$1"
}

check_fail() {
  DOCTOR_FAILS=$((DOCTOR_FAILS + 1))
  printf 'FAIL %s\n' "$1"
}

check_file_exists() {
  local path="$1"
  if [ -f "$path" ]; then
    check_pass "$2"
  else
    check_fail "$2 (missing: $path)"
  fi
}

check_dir_exists() {
  local path="$1"
  if [ -d "$path" ]; then
    check_pass "$2"
  else
    check_fail "$2 (missing: $path)"
  fi
}

BUDGET_HISTORY_FILE=""
BUDGET_GROWTH_THRESHOLD_PERCENT=10

doctor_init_budget_history() {
  local root="$1"
  BUDGET_HISTORY_FILE="$root/.agent-state/doctor-budget-history.tsv"
}

read_prior_word_count() {
  local key="$1"
  [ -n "$BUDGET_HISTORY_FILE" ] || return 1
  [ -f "$BUDGET_HISTORY_FILE" ] || return 1
  awk -v k="$key" -F '\t' '$1 == k { print $2; exit }' "$BUDGET_HISTORY_FILE"
}

write_word_count() {
  local key="$1"
  local count="$2"
  [ -n "$BUDGET_HISTORY_FILE" ] || return 0
  mkdir -p "$(dirname "$BUDGET_HISTORY_FILE")" || return 0
  local tmp
  tmp="$(mktemp)" || return 0
  if [ -f "$BUDGET_HISTORY_FILE" ]; then
    awk -v k="$key" -F '\t' '$1 != k' "$BUDGET_HISTORY_FILE" > "$tmp"
  fi
  printf '%s\t%s\n' "$key" "$count" >> "$tmp"
  mv "$tmp" "$BUDGET_HISTORY_FILE"
}

check_word_budget() {
  local path="$1"
  local limit="$2"
  local label="$3"

  if [ ! -f "$path" ]; then
    check_warn "$label budget skipped; missing file ($path)"
    return 0
  fi

  local count
  count="$(wc -w < "$path" | tr -d ' ')"
  if [ "$count" -le "$limit" ]; then
    check_pass "$label stays within token budget ($count <= $limit words)"
  else
    check_warn "$label exceeds token budget ($count > $limit words)"
  fi

  local prior
  prior="$(read_prior_word_count "$path" 2>/dev/null || true)"
  if [ -n "$prior" ] && [ "$prior" -gt 0 ] 2>/dev/null; then
    # Warn when a file grows by more than the configured percent threshold
    # between doctor runs, so we catch drift before it crosses the absolute
    # budget. Arithmetic stays integer-only: count > prior * (100 + pct) / 100.
    local threshold=$(( prior * (100 + BUDGET_GROWTH_THRESHOLD_PERCENT) / 100 ))
    if [ "$count" -gt "$threshold" ]; then
      local delta=$(( count - prior ))
      check_warn "$label grew by $delta words since last doctor run ($prior -> $count, >${BUDGET_GROWTH_THRESHOLD_PERCENT}%)"
    fi
  fi

  write_word_count "$path" "$count"
}

registration_root_matches() {
  local file="$1"
  local root="$2"
  [ -f "$file" ] || return 1
  grep -Fq "$START_MARKER" "$file" || return 1

  # Match only inside the AgentCrew-managed block so loader text in unrelated
  # parts of the file (a sibling comment, an example, another agent's loader)
  # cannot cause a false positive when the actual managed path differs.
  local block
  block="$(awk -v start="$START_MARKER" -v end="$END_MARKER" '
    $0 == start { in_block = 1; next }
    $0 == end { in_block = 0; next }
    in_block { print }
  ' "$file")"

  printf '%s\n' "$block" | grep -Fq "$root/AGENTS.md" \
    || printf '%s\n' "$block" | grep -Fq "$root/agent-team" \
    || printf '%s\n' "$block" | grep -Fq "$root"
}

doctor_registration() {
  local name="$1"
  local file="$2"
  local root="$3"

  if has_registration "$file"; then
    if registration_root_matches "$file" "$root"; then
      check_pass "$name loader is installed and points to this AgentCrew checkout"
    else
      check_warn "$name loader exists but may point to a different AgentCrew checkout ($file)"
    fi
    # Loader files steer every future agent session; warn when permissions
    # let group or world read, write, or execute them (security review LOW-3).
    if [ -f "$file" ]; then
      local mode group_other
      mode="$(stat -c '%a' "$file" 2>/dev/null || stat -f '%Lp' "$file" 2>/dev/null || true)"
      if [ -n "$mode" ]; then
        group_other="$(printf '%s' "$mode" | tail -c 2)"
        if [ "$group_other" != "00" ]; then
          check_warn "$name loader has permissions $mode; consider 'chmod 600 $file' so other users cannot influence agent behavior"
        fi
      fi
    fi
  else
    check_warn "$name loader is not installed ($file)"
  fi
}

doctor_required_files() {
  local root="$1"

  check_file_exists "$root/AGENTS.md" "AGENTS.md exists"
  check_dir_exists "$root/agent-team" "agent-team/ exists"
  check_file_exists "$root/agent-team/README.md" "agent-team README exists"
  check_file_exists "$root/agent-team/context/route-index.md" "route index exists"
  check_file_exists "$root/agent-team/playbooks/fast-lane.md" "Fast Lane playbook exists"
  check_file_exists "$root/agent-team/playbooks/full-lane.md" "Full Lane playbook exists"
  check_file_exists "$root/agent-team/playbooks/task-classification.md" "task classification playbook exists"
  check_file_exists "$root/agent-team/playbooks/request-routing.md" "request routing playbook exists"
  check_file_exists "$root/agent-team/playbooks/task-intake.md" "task intake playbook exists"
  check_file_exists "$root/agent-team/playbooks/project-presets.md" "project presets playbook exists"
  check_file_exists "$root/agent-team/playbooks/acceptance-criteria.md" "acceptance criteria playbook exists"
  check_file_exists "$root/agent-team/playbooks/work-planning.md" "work planning playbook exists"
  check_file_exists "$root/agent-team/playbooks/implementation-readiness.md" "implementation readiness playbook exists"
  check_file_exists "$root/agent-team/playbooks/pr-preparation.md" "PR preparation playbook exists"
  check_file_exists "$root/agent-team/playbooks/release-management.md" "release management playbook exists"
  check_file_exists "$root/agent-team/playbooks/support-triage.md" "support triage playbook exists"
  check_file_exists "$root/agent-team/playbooks/quality-profile-selection.md" "quality profile selection playbook exists"
  check_file_exists "$root/agent-team/playbooks/human-decision-queue.md" "human decision queue playbook exists"
  check_file_exists "$root/agent-team/playbooks/token-safe-mode.md" "Token-Safe Mode playbook exists"
  check_file_exists "$root/agent-team/skills/registry-guidance.md" "Skills registry guidance exists"
  check_file_exists "$root/agent-team/skills/registry.md" "Skills registry exists"
  check_file_exists "$root/agent-team/protocols/communication.md" "communication protocol exists"
  check_file_exists "$root/agent-team/protocols/state-artifacts.md" "state artifacts protocol exists"
  check_file_exists "$root/agent-team/protocols/checkpoint-blocks.md" "checkpoint blocks protocol exists"
  check_file_exists "$root/agent-team/checklists/agentcrew-health-check.md" "AgentCrew health checklist exists"
