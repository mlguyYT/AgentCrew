  local args=(--project "$project")
  [ "$dry_run" = "true" ] && args+=(--dry-run)
  [ "$force" = "true" ] && args+=(--force)
  "$preparer" "${args[@]}"
}


run_save_session() {
  local root="$1"
  local project="$2"
  local title="$3"
  local summary="$4"
  local checkpoint_block="$5"
  local out_dir="$6"
  shift 6
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  local saver="$root/agent-team/tools/save-session.sh"
  [ -x "$saver" ] || die "Missing executable session save tool: $saver"

  local args=(--project "$project" --title "$title")
  [ -n "$summary" ] && args+=(--summary "$summary")
  [ -n "$out_dir" ] && args+=(--out-dir "$out_dir")
  [ "$checkpoint_block" = "true" ] && args+=(--checkpoint-block)
  while [ "$#" -gt 0 ]; do
    args+=("$1" "$2")
    shift 2
  done
  "$saver" "${args[@]}"
}

run_restore_session() {
  local root="$1"
  local project="$2"
  local out_dir="$3"
  local file="$4"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  local restorer="$root/agent-team/tools/restore-session.sh"
  [ -x "$restorer" ] || die "Missing executable session restore tool: $restorer"

  local args=(--project "$project")
  [ -n "$out_dir" ] && args+=(--out-dir "$out_dir")
  [ -n "$file" ] && args+=(--file "$file")
  "$restorer" "${args[@]}"
}

run_status() {
  local root="$1"
  local project="$2"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  printf '%s\n' "AgentCrew Status"
  printf '%s\n' ""
  printf '%s\n' "Global Loaders"
  status_agent "Claude Code" "$(claude_file)"
  status_agent "Codex" "$(codex_file)"
  status_agent "OpenClaw" "$(openclaw_file)"
  status_agent "Hermes Agent" "$(hermes_file)"
  printf '%s\n' ""

  local status_tool="$root/agent-team/tools/project-status.sh"
  [ -x "$status_tool" ] || die "Missing executable project status dashboard: $status_tool"
  "$status_tool" --project "$project"
}

COMMAND="${1:-}"
[ "$#" -gt 0 ] && shift || true

AGENT="all"
ROOT="$DEFAULT_ROOT"
DRY_RUN="false"
FORCE="false"
PROJECT="."
TASK=""
TITLE="session"
SUMMARY=""
OUT_DIR=""
SESSION_FILE=""
DECISION_ARGS=()
NEXT_ARGS=()
NOTE_ARGS=()
TRIED_ARGS=()
RISK_ARGS=()
SKILL_ARGS=()
VALIDATION_ARGS=()
POSITIONAL_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent)
      [ "$#" -ge 2 ] || die "Missing value for --agent" 2
      AGENT="$2"
      shift 2
      ;;
    --root)
      [ "$#" -ge 2 ] || die "Missing value for --root" 2
      ROOT="$2"
      shift 2
      ;;
    --project)
      [ "$#" -ge 2 ] || die "Missing value for --project" 2
      PROJECT="$2"
      shift 2
      ;;
    --task)
      [ "$#" -ge 2 ] || die "Missing value for --task" 2
      TASK="$2"
      shift 2
      ;;
    --title)
      [ "$#" -ge 2 ] || die "Missing value for --title" 2
      TITLE="$2"
      shift 2
      ;;
    --summary)
      [ "$#" -ge 2 ] || die "Missing value for --summary" 2
      SUMMARY="$2"
      shift 2
      ;;
    --decision)
      [ "$#" -ge 2 ] || die "Missing value for --decision" 2
      DECISION_ARGS+=(--decision "$2")
      shift 2
      ;;
    --next)
      [ "$#" -ge 2 ] || die "Missing value for --next" 2
      NEXT_ARGS+=(--next "$2")
      shift 2
      ;;
    --note)
      [ "$#" -ge 2 ] || die "Missing value for --note" 2
      NOTE_ARGS+=(--note "$2")
      shift 2
      ;;
    --tried)
      [ "$#" -ge 2 ] || die "Missing value for --tried" 2
      TRIED_ARGS+=(--tried "$2")
      shift 2
      ;;
    --risk)
      [ "$#" -ge 2 ] || die "Missing value for --risk" 2
      RISK_ARGS+=(--risk "$2")
      shift 2
      ;;
    --skill)
      [ "$#" -ge 2 ] || die "Missing value for --skill" 2
      SKILL_ARGS+=(--skill "$2")
      shift 2
      ;;
    --validation)
      [ "$#" -ge 2 ] || die "Missing value for --validation" 2
      VALIDATION_ARGS+=(--validation "$2")
      shift 2
      ;;
    --file)
      [ "$#" -ge 2 ] || die "Missing value for --file" 2
      SESSION_FILE="$2"
      shift 2
      ;;
    --out-dir)
      [ "$#" -ge 2 ] || die "Missing value for --out-dir" 2
      OUT_DIR="$2"
      shift 2
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [ "$COMMAND" = "classify" ] || [ "$COMMAND" = "context" ] || [ "$COMMAND" = "start" ] || [ "$COMMAND" = "brief" ] || [ "$COMMAND" = "plan" ]; then
        POSITIONAL_ARGS+=("$1")
        shift
      else
        die "Unknown option: $1" 2
      fi
      ;;
  esac
done

if { [ "$COMMAND" = "classify" ] || [ "$COMMAND" = "context" ] || [ "$COMMAND" = "start" ] || [ "$COMMAND" = "brief" ] || [ "$COMMAND" = "plan" ]; } && [ -z "$TASK" ] && [ "${#POSITIONAL_ARGS[@]}" -gt 0 ]; then
  TASK="${POSITIONAL_ARGS[*]}"
fi

case "$COMMAND" in
  install)
    ROOT="$(absolute_path "$ROOT")"
    require_agentcrew_root "$ROOT"
    install_agent "$AGENT" "$ROOT" "$DRY_RUN"
    printf '%s\n' ""
    printf '%s\n' "AgentCrew registration complete."
    printf '%s\n' "Open any project and enjoy development with your AgentCrew."
    ;;
  uninstall)
    uninstall_agent "$AGENT" "$DRY_RUN"
    printf '%s\n' ""
    printf '%s\n' "AgentCrew loader removal complete."
    ;;
  status)
    run_status "$ROOT" "$PROJECT"
    ;;
  doctor)
    run_doctor "$ROOT"
    ;;
  detect-project)
    run_detect_project "$ROOT" "$PROJECT"
    ;;
  preset)
    run_preset "$ROOT" "$PROJECT" "$DRY_RUN" "$FORCE"
    ;;
  classify)
    run_classify "$ROOT" "$PROJECT" "$TASK"
    ;;
  context)
    run_context "$ROOT" "$PROJECT" "$TASK"
    ;;
  start)
    run_start "$ROOT" "$PROJECT" "$TASK" "$DRY_RUN" "$FORCE"
    ;;
  brief)
    run_brief "$ROOT" "$PROJECT" "$TASK" "$DRY_RUN" "$FORCE"
    ;;
  plan)
    run_plan "$ROOT" "$PROJECT" "$TASK" "$DRY_RUN" "$FORCE"
    ;;
  ready)
    run_ready "$ROOT" "$PROJECT" "$DRY_RUN" "$FORCE"
    ;;
  pr-pack)
    run_pr_pack "$ROOT" "$PROJECT" "$DRY_RUN" "$FORCE"
    ;;
  save-session)
    run_save_session "$ROOT" "$PROJECT" "$TITLE" "$SUMMARY" "false" "$OUT_DIR" "${DECISION_ARGS[@]}" "${NEXT_ARGS[@]}" "${NOTE_ARGS[@]}" "${TRIED_ARGS[@]}" "${RISK_ARGS[@]}" "${SKILL_ARGS[@]}" "${VALIDATION_ARGS[@]}"
    ;;
  checkpoint)
    run_save_session "$ROOT" "$PROJECT" "$TITLE" "$SUMMARY" "true" "$OUT_DIR" "${DECISION_ARGS[@]}" "${NEXT_ARGS[@]}" "${NOTE_ARGS[@]}" "${TRIED_ARGS[@]}" "${RISK_ARGS[@]}" "${SKILL_ARGS[@]}" "${VALIDATION_ARGS[@]}"
    ;;
  restore-session)
    run_restore_session "$ROOT" "$PROJECT" "$OUT_DIR" "$SESSION_FILE"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    die "Unknown command: $COMMAND" 2
    ;;
esac
