#!/usr/bin/env bash
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)" || exit 1
DEFAULT_ROOT="$(cd "$SELF_DIR/.." && pwd -P)" || exit 1

START_MARKER="<!-- AgentCrew global loader: start -->"
END_MARKER="<!-- AgentCrew global loader: end -->"

usage() {
  printf '%s\n' "Usage: agentcrew COMMAND [options]"
  printf '%s\n' ""
  printf '%s\n' "Commands:"
  printf '%s\n' "  install             Register AgentCrew with supported coding agents"
  printf '%s\n' "  status              Show registrations and project dashboard"
  printf '%s\n' "  doctor              Check AgentCrew setup health"
  printf '%s\n' "  detect-project      Detect project stack, tools, and suggested Skills"
  printf '%s\n' "  classify            Classify a request into lane, role, Skills, and gates"
  printf '%s\n' "  start               Start a task and write .agent-state/current-task.md"
  printf '%s\n' ""
  printf '%s\n' "Options:"
  printf '%s\n' "  --agent NAME        all, claude, codex, or openclaw. Default: all"
  printf '%s\n' "  --root PATH         AgentCrew checkout path. Default: this checkout"
  printf '%s\n' "  --project PATH      Target project path. Default: current directory"
  printf '%s\n' "  --task TEXT         Request text for classify or start"
  printf '%s\n' "  --force             Overwrite current task when using start"
  printf '%s\n' "  --dry-run           Print planned changes without writing files"
  printf '%s\n' "  -h, --help          Show help"
}

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

absolute_path() {
  local path="$1"
  [ -d "$path" ] || die "AgentCrew root does not exist: $path"
  (cd "$path" && pwd -P) || exit 1
}

require_agentcrew_root() {
  local root="$1"
  [ -f "$root/AGENTS.md" ] || die "Missing AGENTS.md in AgentCrew root: $root"
  [ -d "$root/agent-team" ] || die "Missing agent-team/ in AgentCrew root: $root"
}

upsert_block() {
  local file="$1"
  local content="$2"
  local dry_run="$3"

  if [ "$dry_run" = "true" ]; then
    printf '%s\n' "Would update: $file"
    printf '%s\n' "$START_MARKER"
    printf '%s\n' "$content"
    printf '%s\n' "$END_MARKER"
    return 0
  fi

  mkdir -p "$(dirname "$file")" || exit 1

  local tmp
  tmp="$(mktemp)" || exit 1

  if [ -f "$file" ]; then
    awk -v start="$START_MARKER" -v end="$END_MARKER" '
      $0 == start { skip = 1; next }
      $0 == end { skip = 0; next }
      skip != 1 { print }
    ' "$file" > "$tmp" || exit 1

    if [ -s "$tmp" ] && [ "$(tail -c 1 "$tmp" | wc -l)" -eq 0 ]; then
      printf '\n' >> "$tmp"
    fi
    if [ -s "$tmp" ]; then
      printf '\n' >> "$tmp"
    fi
  fi

  {
    cat "$tmp"
    printf '%s\n' "$START_MARKER"
    printf '%s\n' "$content"
    printf '%s\n' "$END_MARKER"
  } > "$file" || exit 1

  rm -f "$tmp"
  printf '%s\n' "Updated: $file"
}

claude_file() {
  printf '%s\n' "$HOME/.claude/CLAUDE.md"
}

codex_file() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
}

openclaw_state_dir() {
  if [ -n "${OPENCLAW_STATE_DIR:-}" ]; then
    printf '%s\n' "$OPENCLAW_STATE_DIR"
  elif [ -n "${OPENCLAW_PROFILE:-}" ]; then
    printf '%s\n' "$HOME/.openclaw-$OPENCLAW_PROFILE"
  else
    printf '%s\n' "$HOME/.openclaw"
  fi
}

openclaw_file() {
  printf '%s\n' "$(openclaw_state_dir)/workspace/AGENTS.md"
}

openclaw_detected() {
  [ -d "$(openclaw_state_dir)" ] || command -v openclaw >/dev/null 2>&1
}

claude_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

@$root/AGENTS.md

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

When working in any project, apply AgentCrew automatically. The user does not need to ask you to load AgentCrew. Classify the request, choose the lane, role, and Skills, read the relevant files under \`$root/agent-team/\`, keep human approval final, and do not merge pull requests.
EOF
}

codex_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

At the start of work in any project, apply AgentCrew automatically. Read:

\`\`\`text
$root/AGENTS.md
$root/agent-team/
\`\`\`

Users do not need to name AgentCrew, a role, a lane, or a Skill. Classify the request, choose Fast Lane or Full Lane, choose the starting role, load relevant Skills from \`$root/agent-team/skills/registry.md\`, keep handoffs compact, keep human approval final, and do not merge pull requests.
EOF
}

openclaw_loader() {
  local root="$1"
  cat <<EOF
# AgentCrew

AgentCrew is installed at:

\`\`\`text
$root
\`\`\`

When handling coding tasks in any project, apply AgentCrew automatically. Read:

\`\`\`text
$root/AGENTS.md
$root/agent-team/
\`\`\`

Users do not need to name AgentCrew, a role, a lane, or a Skill. Classify the request, choose Fast Lane or Full Lane, choose the starting role, load relevant Skills from \`$root/agent-team/skills/registry.md\`, keep handoffs compact, keep human approval final, and do not merge pull requests.

AgentCrew is a coding-team workflow. It does not override OpenClaw identity, memory, channel, heartbeat, or safety instructions. If AgentCrew and OpenClaw instructions conflict, preserve safety, privacy, and human approval.
EOF
}

install_agent() {
  local agent="$1"
  local root="$2"
  local dry_run="$3"

  case "$agent" in
    claude)
      upsert_block "$(claude_file)" "$(claude_loader "$root")" "$dry_run"
      ;;
    codex)
      upsert_block "$(codex_file)" "$(codex_loader "$root")" "$dry_run"
      ;;
    openclaw)
      upsert_block "$(openclaw_file)" "$(openclaw_loader "$root")" "$dry_run"
      ;;
    all)
      install_agent claude "$root" "$dry_run"
      install_agent codex "$root" "$dry_run"
      if openclaw_detected; then
        install_agent openclaw "$root" "$dry_run"
      else
        printf '%s\n' "Skipped OpenClaw: not detected. Use --agent openclaw to create the loader explicitly."
      fi
      ;;
    *)
      die "Unsupported agent: $agent" 2
      ;;
  esac
}

has_registration() {
  local file="$1"
  [ -f "$file" ] && grep -Fq "$START_MARKER" "$file"
}

status_agent() {
  local name="$1"
  local file="$2"
  if has_registration "$file"; then
    printf '%s\n' "$name: installed ($file)"
  else
    printf '%s\n' "$name: not installed ($file)"
  fi
}


DOCTOR_FAILS=0
DOCTOR_WARNINGS=0

check_pass() {
  printf 'PASS %s\n' "$1"
}

check_warn() {
  DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1))
  printf 'WARN %s\n' "$1"
}

check_fail() {
  DOCTOR_FAILS=$((DOCTOR_FAILS + 1))
  printf 'FAIL %s\n' "$1"
}

check_file_exists() {
  local path="$1"
  if [ -f "$path" ]; then
    check_pass "$2"
  else
    check_fail "$2 (missing: $path)"
  fi
}

check_dir_exists() {
  local path="$1"
  if [ -d "$path" ]; then
    check_pass "$2"
  else
    check_fail "$2 (missing: $path)"
  fi
}

registration_root_matches() {
  local file="$1"
  local root="$2"
  [ -f "$file" ] || return 1
  grep -Fq "$START_MARKER" "$file" || return 1
  grep -Fq "$root/AGENTS.md" "$file" || grep -Fq "$root/agent-team" "$file" || grep -Fq "$root" "$file"
}

doctor_registration() {
  local name="$1"
  local file="$2"
  local root="$3"

  if has_registration "$file"; then
    if registration_root_matches "$file" "$root"; then
      check_pass "$name loader is installed and points to this AgentCrew checkout"
    else
      check_warn "$name loader exists but may point to a different AgentCrew checkout ($file)"
    fi
  else
    check_warn "$name loader is not installed ($file)"
  fi
}

doctor_required_files() {
  local root="$1"

  check_file_exists "$root/AGENTS.md" "AGENTS.md exists"
  check_dir_exists "$root/agent-team" "agent-team/ exists"
  check_file_exists "$root/agent-team/README.md" "agent-team README exists"
  check_file_exists "$root/agent-team/context/route-index.md" "route index exists"
  check_file_exists "$root/agent-team/playbooks/fast-lane.md" "Fast Lane playbook exists"
  check_file_exists "$root/agent-team/playbooks/full-lane.md" "Full Lane playbook exists"
  check_file_exists "$root/agent-team/playbooks/task-classification.md" "task classification playbook exists"
  check_file_exists "$root/agent-team/playbooks/request-routing.md" "request routing playbook exists"
  check_file_exists "$root/agent-team/playbooks/task-intake.md" "task intake playbook exists"
  check_file_exists "$root/agent-team/playbooks/quality-profile-selection.md" "quality profile selection playbook exists"
  check_file_exists "$root/agent-team/playbooks/human-decision-queue.md" "human decision queue playbook exists"
  check_file_exists "$root/agent-team/playbooks/token-safe-mode.md" "Token-Safe Mode playbook exists"
  check_file_exists "$root/agent-team/skills/registry.md" "Skills registry exists"
  check_file_exists "$root/agent-team/protocols/communication.md" "communication protocol exists"
  check_file_exists "$root/agent-team/protocols/state-artifacts.md" "state artifacts protocol exists"
  check_file_exists "$root/agent-team/checklists/agentcrew-health-check.md" "AgentCrew health checklist exists"
  check_file_exists "$root/agent-team/quality-profiles/light.md" "quality profile exists: light"
  check_file_exists "$root/agent-team/quality-profiles/standard.md" "quality profile exists: standard"
  check_file_exists "$root/agent-team/quality-profiles/strict.md" "quality profile exists: strict"
  check_file_exists "$root/agent-team/quality-profiles/regulated.md" "quality profile exists: regulated"
  check_file_exists "$root/docs/auto-load.md" "auto-load documentation exists"
  check_file_exists "$root/docs/doctor.md" "doctor documentation exists"
  check_file_exists "$root/docs/project-detection.md" "project detection documentation exists"
  check_file_exists "$root/docs/task-classifier.md" "task classifier documentation exists"
  check_file_exists "$root/docs/task-intake.md" "task intake documentation exists"
  check_file_exists "$root/docs/status-dashboard.md" "status dashboard documentation exists"
  check_file_exists "$root/docs/human-decision-queue.md" "human decision queue documentation exists"
  check_file_exists "$root/docs/quality-profiles.md" "quality profiles documentation exists"
  check_file_exists "$root/docs/installation.md" "installation documentation exists"
}

doctor_agent_roles() {
  local root="$1"
  local role

  for role in \
    advisor idea-consultant product-manager developer tester reviewer \
    security-reviewer ux-design-reviewer documentation-agent skill-validator \
    llm-agent researcher-agent cnn-agent
  do
    check_file_exists "$root/agent-team/agents/$role.md" "role exists: $role"
  done
}

doctor_templates() {
  local root="$1"
  local template

  for template in \
    pr-description test-report review-report security-review-report \
    ux-design-review-report documentation-report skill-validation-report \
    memory-summary task-routing current-task human-decision-queue compact-handoff compact-test-report compact-review-report
  do
    check_file_exists "$root/agent-team/templates/$template.md" "template exists: $template"
  done
}

doctor_project_context() {
  local root="$1"
  local current
  current="$(pwd -P)" || current="."

  printf '\nProject context:\n'
  printf '  current directory: %s\n' "$current"

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local git_root
    git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$git_root" ]; then
      printf '  git root: %s\n' "$git_root"
    fi
  else
    check_warn "current directory is not inside a git worktree"
  fi

  if [ "$current" = "$root" ]; then
    if [ -f "$root/.gitignore" ] && grep -Eq '(^|/)[.]agent-state/ *$|^[.]agent-state/ *$' "$root/.gitignore"; then
      check_pass "AgentCrew repository ignores its own .agent-state/"
    else
      check_warn "AgentCrew repository should ignore its own .agent-state/"
    fi
  else
    check_pass "AgentCrew is external to the current project"
    if [ -d ".agent-state" ]; then
      check_pass "current project has .agent-state/ for project-local memory"
    else
      check_warn "current project has no .agent-state/ yet; this is normal until session memory is saved"
    fi
  fi
}

doctor_tools() {
  local root="$1"

  if command -v git >/dev/null 2>&1; then
    check_pass "git is available"
  else
    check_warn "git is not available"
  fi

  if [ -x "$root/bin/agentcrew" ]; then
    check_pass "agentcrew CLI is executable"
  else
    check_warn "agentcrew CLI is not executable"
  fi

  if [ -x "$root/agent-team/tools/detect-project.sh" ]; then
    check_pass "project detector is executable"
  else
    check_warn "project detector is not executable"
  fi

  if [ -x "$root/agent-team/tools/classify-task.sh" ]; then
    check_pass "task classifier is executable"
  else
    check_warn "task classifier is not executable"
  fi

  if [ -x "$root/agent-team/tools/start-task.sh" ]; then
    check_pass "task intake tool is executable"
  else
    check_warn "task intake tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/project-status.sh" ]; then
    check_pass "project status dashboard is executable"
  else
    check_warn "project status dashboard is not executable"
  fi
}

run_doctor() {
  local root="$1"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  printf 'AgentCrew Doctor\n'
  printf 'Root: %s\n\n' "$root"

  printf 'Core files:\n'
  doctor_required_files "$root"

  printf '\nAgent roles:\n'
  doctor_agent_roles "$root"

  printf '\nTemplates:\n'
  doctor_templates "$root"

  printf '\nGlobal loaders:\n'
  doctor_registration "Claude Code" "$(claude_file)" "$root"
  doctor_registration "Codex" "$(codex_file)" "$root"
  if openclaw_detected; then
    doctor_registration "OpenClaw" "$(openclaw_file)" "$root"
  else
    check_warn "OpenClaw not detected; loader check skipped"
  fi

  printf '\nLocal tools:\n'
  doctor_tools "$root"

  doctor_project_context "$root"

  printf '\nSummary:\n'
  printf '  failures: %s\n' "$DOCTOR_FAILS"
  printf '  warnings: %s\n' "$DOCTOR_WARNINGS"

  if [ "$DOCTOR_FAILS" -gt 0 ]; then
    printf '\nAgentCrew doctor found blocking setup issues.\n'
    return 1
  fi

  if [ "$DOCTOR_WARNINGS" -gt 0 ]; then
    printf '\nAgentCrew doctor completed with warnings.\n'
  else
    printf '\nAgentCrew doctor passed.\n'
  fi
}


run_detect_project() {
  local root="$1"
  local project="$2"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  local detector="$root/agent-team/tools/detect-project.sh"
  [ -x "$detector" ] || die "Missing executable project detector: $detector"
  "$detector" --project "$project"
}

run_classify() {
  local root="$1"
  local project="$2"
  local task="$3"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  [ -n "$task" ] || die 'Missing request text. Use: agentcrew classify "Fix login validation"' 2
  local classifier="$root/agent-team/tools/classify-task.sh"
  [ -x "$classifier" ] || die "Missing executable task classifier: $classifier"
  "$classifier" --project "$project" --task "$task"
}

run_start() {
  local root="$1"
  local project="$2"
  local task="$3"
  local dry_run="$4"
  local force="$5"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  [ -n "$task" ] || die 'Missing request text. Use: agentcrew start "Fix login validation"' 2
  local starter="$root/agent-team/tools/start-task.sh"
  [ -x "$starter" ] || die "Missing executable task intake tool: $starter"

  local args=(--project "$project" --task "$task")
  [ "$dry_run" = "true" ] && args+=(--dry-run)
  [ "$force" = "true" ] && args+=(--force)
  "$starter" "${args[@]}"
}

run_status() {
  local root="$1"
  local project="$2"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  printf '%s\n' "AgentCrew Status"
  printf '%s\n' ""
  printf '%s\n' "Global Loaders"
  status_agent "Claude Code" "$(claude_file)"
  status_agent "Codex" "$(codex_file)"
  status_agent "OpenClaw" "$(openclaw_file)"
  printf '%s\n' ""

  local status_tool="$root/agent-team/tools/project-status.sh"
  [ -x "$status_tool" ] || die "Missing executable project status dashboard: $status_tool"
  "$status_tool" --project "$project"
}

COMMAND="${1:-}"
[ "$#" -gt 0 ] && shift || true

AGENT="all"
ROOT="$DEFAULT_ROOT"
DRY_RUN="false"
FORCE="false"
PROJECT="."
TASK=""
POSITIONAL_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent)
      [ "$#" -ge 2 ] || die "Missing value for --agent" 2
      AGENT="$2"
      shift 2
      ;;
    --root)
      [ "$#" -ge 2 ] || die "Missing value for --root" 2
      ROOT="$2"
      shift 2
      ;;
    --project)
      [ "$#" -ge 2 ] || die "Missing value for --project" 2
      PROJECT="$2"
      shift 2
      ;;
    --task)
      [ "$#" -ge 2 ] || die "Missing value for --task" 2
      TASK="$2"
      shift 2
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [ "$COMMAND" = "classify" ] || [ "$COMMAND" = "start" ]; then
        POSITIONAL_ARGS+=("$1")
        shift
      else
        die "Unknown option: $1" 2
      fi
      ;;
  esac
done

if { [ "$COMMAND" = "classify" ] || [ "$COMMAND" = "start" ]; } && [ -z "$TASK" ] && [ "${#POSITIONAL_ARGS[@]}" -gt 0 ]; then
  TASK="${POSITIONAL_ARGS[*]}"
fi

case "$COMMAND" in
  install)
    ROOT="$(absolute_path "$ROOT")"
    require_agentcrew_root "$ROOT"
    install_agent "$AGENT" "$ROOT" "$DRY_RUN"
    printf '%s\n' ""
    printf '%s\n' "AgentCrew registration complete."
    printf '%s\n' "Open any project and enjoy development with your AgentCrew."
    ;;
  status)
    run_status "$ROOT" "$PROJECT"
    ;;
  doctor)
    run_doctor "$ROOT"
    ;;
  detect-project)
    run_detect_project "$ROOT" "$PROJECT"
    ;;
  classify)
    run_classify "$ROOT" "$PROJECT" "$TASK"
    ;;
  start)
    run_start "$ROOT" "$PROJECT" "$TASK" "$DRY_RUN" "$FORCE"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    die "Unknown command: $COMMAND" 2
    ;;
esac
