doctor_agent_roles() {
  local root="$1"
  local role

  for role in \
    advisor idea-consultant product-manager developer tester reviewer \
    security-reviewer ux-design-reviewer documentation-agent support-triage-agent release-manager skill-validator \
    llm-agent researcher-agent cnn-agent
  do
    check_file_exists "$root/agent-team/agents/$role.md" "role exists: $role"
  done
}

doctor_templates() {
  local root="$1"
  local template

  for template in \
    pr-description test-report review-report security-review-report \
    ux-design-review-report documentation-report support-triage-report release-report skill-validation-report \
    memory-summary task-routing current-task project-preset task-brief work-plan readiness-report pr-pack human-decision-queue compact-handoff compact-test-report compact-review-report compact-research-report
  do
    check_file_exists "$root/agent-team/templates/$template.md" "template exists: $template"
  done
}

doctor_token_budgets() {
  local root="$1"

  check_word_budget "$root/AGENTS.md" 1200 "AGENTS.md"
  check_word_budget "$root/agent-team/context/route-index.md" 450 "route index"
  check_word_budget "$root/agent-team/protocols/token-discipline.md" 400 "token discipline protocol"
  check_word_budget "$root/agent-team/context/fast-lane-context.md" 250 "Fast Lane context"
  check_word_budget "$root/agent-team/context/full-lane-context.md" 250 "Full Lane context"
  check_word_budget "$root/agent-team/skills/registry.md" 500 "Skills registry"
}

doctor_project_context() {
  local root="$1"
  local current
  current="$(pwd -P)" || current="."

  printf '\nProject context:\n'
  printf '  current directory: %s\n' "$current"

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local git_root
    git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$git_root" ]; then
      printf '  git root: %s\n' "$git_root"
    fi
  else
    check_warn "current directory is not inside a git worktree"
  fi

  if [ "$current" = "$root" ]; then
    if [ -f "$root/.gitignore" ] && grep -Eq '(^|/)[.]agent-state/ *$|^[.]agent-state/ *$' "$root/.gitignore"; then
      check_pass "AgentCrew repository ignores its own .agent-state/"
    else
      check_warn "AgentCrew repository should ignore its own .agent-state/"
    fi
  else
    check_pass "AgentCrew is external to the current project"
    if [ -d ".agent-state" ]; then
      check_pass "current project has .agent-state/ for project-local memory"
    else
      check_warn "current project has no .agent-state/ yet; this is normal until session memory is saved"
    fi
  fi
}

doctor_tools() {
  local root="$1"

  if command -v git >/dev/null 2>&1; then
    check_pass "git is available"
  else
    check_warn "git is not available"
  fi

  if [ -x "$root/bin/agentcrew" ]; then
    check_pass "agentcrew CLI is executable"
  else
    check_warn "agentcrew CLI is not executable"
  fi

  if [ -x "$root/agent-team/tools/detect-project.sh" ]; then
    check_pass "project detector is executable"
  else
    check_warn "project detector is not executable"
  fi

  if [ -x "$root/agent-team/tools/classify-task.sh" ]; then
    check_pass "task classifier is executable"
  else
    check_warn "task classifier is not executable"
  fi

  if [ -x "$root/agent-team/tools/context-manifest.sh" ]; then
    check_pass "context manifest tool is executable"
  else
    check_warn "context manifest tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/select-preset.sh" ]; then
    check_pass "project preset selector is executable"
  else
    check_warn "project preset selector is not executable"
  fi

  if [ -x "$root/agent-team/tools/start-task.sh" ]; then
    check_pass "task intake tool is executable"
  else
    check_warn "task intake tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/brief-task.sh" ]; then
    check_pass "task brief tool is executable"
  else
    check_warn "task brief tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/plan-task.sh" ]; then
    check_pass "work plan tool is executable"
  else
    check_warn "work plan tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/ready-check.sh" ]; then
    check_pass "implementation readiness tool is executable"
  else
    check_warn "implementation readiness tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/prepare-pr-pack.sh" ]; then
    check_pass "PR packet tool is executable"
  else
    check_warn "PR packet tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/project-status.sh" ]; then
    check_pass "project status dashboard is executable"
  else
    check_warn "project status dashboard is not executable"
  fi

  if [ -x "$root/agent-team/tools/save-session.sh" ]; then
    check_pass "session save tool is executable"
  else
    check_warn "session save tool is not executable"
  fi

  if [ -x "$root/agent-team/tools/restore-session.sh" ]; then
    check_pass "session restore tool is executable"
  else
    check_warn "session restore tool is not executable"
  fi
}

run_doctor() {
  local root="$1"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  printf 'AgentCrew Doctor\n'
  printf 'Root: %s\n\n' "$root"

  printf 'Core files:\n'
  doctor_required_files "$root"

  printf '\nAgent roles:\n'
  doctor_agent_roles "$root"

  printf '\nTemplates:\n'
  doctor_templates "$root"

  printf '\nGlobal loaders:\n'
  doctor_registration "Claude Code" "$(claude_file)" "$root"
  doctor_registration "Codex" "$(codex_file)" "$root"
  if openclaw_detected; then
    doctor_registration "OpenClaw" "$(openclaw_file)" "$root"
  else
    check_warn "OpenClaw not detected; loader check skipped"
  fi
  if hermes_detected; then
    doctor_registration "Hermes Agent" "$(hermes_file)" "$root"
  else
    check_warn "Hermes Agent not detected; loader check skipped"
  fi

  printf '\nLocal tools:\n'
  doctor_tools "$root"

  printf '\nToken budgets:\n'
  doctor_init_budget_history "$root"
  doctor_token_budgets "$root"

  doctor_project_context "$root"

  printf '\nSummary:\n'
  printf '  failures: %s\n' "$DOCTOR_FAILS"
  printf '  warnings: %s\n' "$DOCTOR_WARNINGS"

  if [ "$DOCTOR_FAILS" -gt 0 ]; then
    printf '\nAgentCrew doctor found blocking setup issues.\n'
    return 1
  fi

  if [ "$DOCTOR_WARNINGS" -gt 0 ]; then
    printf '\nAgentCrew doctor completed with warnings.\n'
  else
    printf '\nAgentCrew doctor passed.\n'
  fi
}


run_detect_project() {
  local root="$1"
  local project="$2"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  local detector="$root/agent-team/tools/detect-project.sh"
  [ -x "$detector" ] || die "Missing executable project detector: $detector"
  "$detector" --project "$project"
}

run_preset() {
  local root="$1"
  local project="$2"
  local dry_run="$3"
  local force="$4"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  local selector="$root/agent-team/tools/select-preset.sh"
  [ -x "$selector" ] || die "Missing executable project preset selector: $selector"

  local args=(--project "$project")
  [ "$dry_run" = "true" ] && args+=(--dry-run)
  [ "$force" = "true" ] && args+=(--force)
  "$selector" "${args[@]}"
}

run_classify() {
  local root="$1"
  local project="$2"
  local task="$3"
  root="$(absolute_path "$root")"
  require_agentcrew_root "$root"

  [ -n "$task" ] || die 'Missing request text. Use: agentcrew classify "Fix login validation"' 2
  local classifier="$root/agent-team/tools/classify-task.sh"
  [ -x "$classifier" ] || die "Missing executable task classifier: $classifier"
  "$classifier" --project "$project" --task "$task"
}

